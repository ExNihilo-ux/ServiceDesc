# .env
# === DATABASE (External / Localhost) ===
POSTGRES_PORT=5432
POSTGRES_DB=airport_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_pass

# === DATABASE (Internal Docker Network) ===
POSTGRES_INTERNAL_HOST=postgres
POSTGRES_INTERNAL_PORT=5432

# === BACKEND ===
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=info

# === MONITORING ===
PROMETHEUS_PORT=9090
PG_EXPORTER_PORT=9187
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_pass