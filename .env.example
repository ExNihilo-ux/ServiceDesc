# .env.example
# === DATABASE ===
POSTGRES_PORT=5432
POSTGRES_DB=airport_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=__REPLACE_WITH_SECURE_PASSWORD__

# === MONITORING ===
