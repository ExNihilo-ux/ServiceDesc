# =============================================================================
# AIRPORT MAINTENANCE BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================
# Скопируйте этот файл в .env и заполните актуальными значениями.
# Никогда не коммитьте реальный .env в репозиторий!

# === DATABASE (External / Localhost) ===
# Параметры для подключения к PostgreSQL с хост-машины (разработка/тесты)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airport_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=Amaz1N15DBpa$5

# === DATABASE POOL SETTINGS ===
# Настройки пула соединений asyncpg
# min_size: минимальное количество всегда открытых соединений
POSTGRES_MIN_SIZE=5
# max_size: максимальное количество одновременных соединений
POSTGRES_MAX_SIZE=20
# statement_timeout: автоматический откат запросов, выполняющихся дольше указанного времени
# Формат: число + единица (s/ms/m). Защита от зависших транзакций.
POSTGRES_STATEMENT_TIMEOUT=30s
# application_name: имя приложения для мониторинга в pg_stat_activity
# Помогает отличать бэкенд от других клиентов БД при диагностике
POSTGRES_APPLICATION_NAME=airport-backend

# === DATABASE (Internal Docker Network) ===
# Параметры для подключения внутри Docker Compose сети
# Используется при деплое или запуске бэкенда в контейнере
POSTGRES_INTERNAL_HOST=postgres
POSTGRES_INTERNAL_PORT=5432

# === BACKEND APPLICATION ===
# Настройки запуска FastAPI приложения
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
APP_ENV=development
LOG_LEVEL=info

# === AI EMBEDDING MODEL ===
# Размерность вектора для эмбеддингов описаний неисправностей
# 1536 = OpenAI text-embedding-3-small (рекомендуется)
# 768  = sentence-transformers/all-MiniLM-L6-v2 (локальная альтернатива)
# Изменение этого значения требует обновления миграций БД и переиндексации
EMBEDDING_DIMENSION=1536

# === MONITORING STACK ===
# Порты для Prometheus, Grafana и экспортеров
PROMETHEUS_PORT=9090
PG_EXPORTER_PORT=9187
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Amaz1N15DBpa$5